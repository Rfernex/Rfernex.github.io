      232.08001708984375,
      821.2427978515625,
      254.48001098632812
    ],
    "text": "Introductory Lecture on Epistemology n°1 : ",
    "size": 15.99999713897705,
    "font": "Poppins-Regular",
    "color": 16777215
  },
  {
    "id": "1:4",
    "page": 0,
    "bbox": [
      485.34539794921875,
      270.96002197265625,
      885.9181518554688,
      293.3600158691406
    ],
    "text": "The Cartesian Cogito and the Mathesis Universalis",
    "size": 15.99999713897705,
    "font": "Poppins-Regular",
